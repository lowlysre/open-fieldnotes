{
  "name": "open-fieldnotes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "check": "tsx scripts/check-repo.ts",
    "fetch": "npm run check && tsx scripts/fetch-discussions.ts",
    "dev": "npm run fetch && astro dev",
    "build": "npm run fetch && astro build",
    "preview": "astro preview",
    "test": "node --import tsx --experimental-test-coverage --test \"**/*.test.ts\"",
    "a11y:config": "tsx scripts/a11y-config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "accessible-astro-components": "^5.8.1",
    "astro": "^7.3.8",
    "color2k": "^2.0.4",
    "fuse.js": "^7.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@octokit/graphql": "^9.0.5",
    "@octokit/graphql-schema": "^15.26.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
